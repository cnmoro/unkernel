[Unit]
Description=Unkernel Xfce desktop
After=kw-setup.service

[Service]
User=user
RuntimeDirectory=kw-desktop
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kw-desktop
Environment=XAUTHORITY=/run/kw-desktop/Xauthority
ExecStart=/usr/local/bin/kw-desktop
KillMode=mixed
TimeoutStopSec=10
