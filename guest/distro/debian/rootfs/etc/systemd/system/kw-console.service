[Unit]
Description=Unkernel console
After=kw-net.service kw-grow-data.service
Wants=kw-grow-data.service

[Service]
ExecStartPre=/usr/lib/kw/welcome
ExecStart=/usr/bin/kwtty login
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/hvc0
Restart=always
RestartSec=1
KillSignal=SIGHUP
TimeoutStopSec=3
